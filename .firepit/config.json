{
  // Firepit per-project config. JSONC: comments and trailing commas are allowed.
  // Commands follow the Linux patterns of ../firepit-template/.firepit/config.json:
  // a group per area, a short lowercase name, a one-line description.

  "version": 1,
  "id": "sac-md-editor",

  "commands": [
    {
      "group": "Run",
      "name": "site",
      "description": "Serves the API page with the live demo on 127.0.0.1:8765.",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "http.server", "8765", "--bind", "127.0.0.1"],
      "window": "reuse:site",
      "longRunning": true
    },

    {
      "group": "Open",
      "name": "demo",
      "description": "The API page with the live demo on the local server.",
      "type": "url",
      "url": "http://127.0.0.1:8765/"
    },

    {
      "group": "Open",
      "name": "tests",
      "description": "The round-trip test page on the local server; its title says PASS or FAIL.",
      "type": "url",
      "url": "http://127.0.0.1:8765/test/"
    },

    {
      "group": "Git",
      "name": "repo",
      "description": "The repository on GitHub.",
      "type": "url",
      "url": "https://github.com/SACRVM/sac-md-editor"
    }
  ]
}
